# Copy to .env only for local reference; server does NOT auto-load .env.
# Use node --env-file=.env server/index.mjs or your hosting secret manager.
APP_ORIGIN=http://localhost:3000
PORT=3000
DATABASE_PATH=./data/scopeboard.sqlite
# Production: NODE_ENV=production and APP_ORIGIN=https://your-real-domain.tld
# Optional: exact trusted reverse-proxy IPs/CIDRs only. Empty = trust no proxy.
# TRUST_PROXY=127.0.0.1/32,::1/128
# Optional payments: all three are required; do not commit real keys.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
